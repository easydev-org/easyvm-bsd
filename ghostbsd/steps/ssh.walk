# ghostbsd 26.3 - the first-boot wizard answered, sshd, and the desktop it lands on.
#
# READ `ghostbsd/steps/install.walk` FIRST. GBI ends with "Installation completed" and the machine is
# killed there - and the published disk boots into "GhostBSD Initial Setup", NOT into a usable system:
#
#	MEASURED in the lab pod on the published `bsd-ghostbsd-install` disk:
#
#		GhostBSD Initial Setup
#		Please select your language:
#		English / Afrikaans / ... / Next
#
# NO ACCOUNT, NO PASSWORD AND NO sshd EXIST UNTIL THAT WIZARD IS ANSWERED. That is what this stage is
# for: it is the `firstboot` half of the install, and until it runs the disk has no `vmuser` to log in as.
#
# THE WIZARD IS GTK, SO IT IS CLICKED. `click_at [1920, 1080]` on every click lets the engine rescale,
# and `Next` sits at the same place on every page - (1330, 782) in the 1920x1080 frame, measured with
# tesseract's own bounding box:
#
#	tesseract w1.png - tsv | awk -F'\t' '$12=="Next" {print $7,$8,$9,$10}'
#	1316 777 28 9
#
# EVERY PAGE IS WAITED FOR, NOT TIMED. A click that lands before the page is drawn goes nowhere, and a
# walk that clicks blindly reports a wizard it never answered.
walkthrough "ghostbsd 26.3 - the first-boot wizard, sshd, and the desktop"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var out
  default out/ghostbsd-ssh.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user
ssh_port 2222


step "boot the published disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-m", "8192"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "e1000,netdev=net0,mac=52:54:00:56:4d:01"]]
    timeout 900


# THE WIZARD'S FIRST PAGE, WHICH IS ALSO THE PROOF THE DISK IS THE ONE THE INSTALL LEFT.
step "the first-boot wizard is up"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name wiz
    until
      bind up
      source wiz
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[ghostbsd, initial, setup], [please, select, your, language]]
    max 60


# THE WIZARD'S PAGES, EACH WAITED FOR AND THEN ADVANCED.
#
# `Next` IS AT THE SAME PLACE ON EVERY PAGE because the wizard is a GtkNotebook with one button box -
# measured at (1330, 782) in the 1920x1080 frame.
step "language - Next, with English already the selection"
  input 1330 782
  click_at [1920, 1080]
  settle 6


step "keyboard - Next"
  input 1330 782
  click_at [1920, 1080]
  settle 6


step "timezone - Next"
  input 1330 782
  click_at [1920, 1080]
  settle 6


step "the account page, which is what makes this disk loggable"
  repeat
    do
      item
        settle 6
      item "read the screen"
        read
          name acct
    until
      bind up
      source acct
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[full, name], [user, name], [password], [username]]
    max 40


# THE FIELDS ARE CLICKED IN ORDER AND TYPED, BECAUSE THE WIZARD WILL NOT ADVANCE WITHOUT A USER.
#
# The three fields sit in one column; each is clicked first so the caret is in it, because a GTK entry
# that was never focused receives nothing.
step "the account's full name"
  input 960 420
  click_at [1920, 1080]
  settle 2


step "type it"
  input text "GhostBSD User"
  settle 2


step "the account's user name"
  input 960 470
  click_at [1920, 1080]
  settle 2


step "type the account"
  input text "{{ user }}"
  settle 2


step "the account's password"
  input 960 520
  click_at [1920, 1080]
  settle 2


step "type the password"
  input text "{{ password }}"
  settle 2


step "its confirmation"
  input 960 570
  click_at [1920, 1080]
  settle 2


step "type it again"
  input text "{{ password }}"
  settle 3


step "finish the wizard"
  input 1330 782
  click_at [1920, 1080]
  settle 10


step "the wizard is done and the desktop is coming up"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name desk
    until
      bind up
      source desk
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      without [[ghostbsd, initial, setup], [please, select, your, language]]
    max 60


# THE NETWORK IS WRITTEN DOWN, NOT NEGOTIATED - THE SAME FINDING FOUR STAGES IN THIS REPOSITORY REACHED.
#
# The tap is `172.30.0.1/24` and serves no DHCP. GhostBSD is FreeBSD underneath, so the interface is a
# `re`/`em`/`vtnet` name the kernel chooses; `ifconfig -l` answers it. FreeBSD's `ifconfig` takes a CIDR
# suffix, and the address is the one every guest here uses.
step "give every real interface the address this cluster uses"
  input text "for i in $(ifconfig -l); do test $i = lo0 || ifconfig $i inet 172.30.0.2/24; done"
  settle 3


step "run it"
  input ret
  settle 8


step "the address the guest reports"
  input text "ifconfig -a | grep 'inet '"
  settle 2


step "run it"
  input ret
  settle 6


# sshd IS ENABLED HERE, BECAUSE THE WIZARD DOES NOT ENABLE IT.
step "enable sshd, which the wizard does not"
  input text "sysrc sshd_enable=YES; service sshd start"
  settle 3


step "run it"
  input ret
  settle 8


# THE PROOF IS THE HOST'S OWN DIAL OF 172.30.0.2:22.
step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"


step "prove the account over ssh"
  ssh "id -un"


step "prove the address over ssh"
  ssh "ifconfig -a | grep 'inet 172.30'"
  timeout 60


# THE DESKTOP, WHICH THE WIZARD'S OWN SESSION LANDS ON. MATE is GhostBSD's default.
step "the desktop is running"
  ssh "pgrep -x marco >/dev/null && echo MATE_UP"
  timeout 60


step "flush the writes before the machine stops"
  ssh "sync"
  timeout 120


step "shut the machine down"
  ssh "shutdown -p now"
  timeout 300


step "publish the disk"
  save "{{ out }}"
