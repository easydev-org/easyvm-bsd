# midnightbsd 4.0.9 - the installed system, over ssh, with the desktop it ships as a package.
#
# THE INSTALL WALK PROVES THE INSTALLER ANSWERED EVERY QUESTION. This one proves the machine that
# came out of it can reach a package mirror and install the desktop MidnightBSD has been built around
# since 2021 - Xfce - and that the session actually comes up on screen.
#
# WHY THE DESKTOP IS HERE AND NOT IN THE INSTALL, WHICH IS WHERE freebsd PUTS IT.
#
# MEASURED, reading the disc this repository installs from (`MidnightBSD-4.0.9--amd64-disc1.iso`,
# 1031 MiB). `usr/midnightbsd-dist/` holds seven sets:
#
#	base.txz  177,887,812   kernel.txz 56,347,824   kernel-dbg.txz 103,999,492
#	lib32.txz  77,197,736   mports.txz 28,520,548   src.txz       207,797,884
#	tests.txz  19,541,932
#
# and NO desktop set at all. `base.txz` unpacks to 28,172 entries of which ZERO are under
# `usr/X11R6`, and `xorg`/`xfce`/`lumina` appear in that list zero times. So the 677 MiB image the
# install leg publishes is a complete base system with an empty `/usr/local` - not a desktop with
# something missing.
#
# THAT IS MIDNIGHTBSD'S OWN DESIGN, not an omission here. Its documentation says so plainly:
#
#	"When you first install MidnightBSD, a script called firstboot ... will ask if you would like to
#	 install a graphical desktop environment. This will allow you to select xfce or WindowMaker."
#	       -- https://www.midnightbsd.org/documentation/desktop.html
#
# and 4.0's release notes name Xfce as the desktop the project builds ("We switched ... to Xfce as
# our desktop environment", midnightbsd.org/about). The packages are not on the disc; they come from
# the project's mirror. A package install is a network operation, so it belongs to the stage that has
# a booted system with an interface and a resolver - this one.
#
# XFCE SPECIFICALLY, BECAUSE IT IS THE PROJECT'S OWN:
#
#	"Install Xfce with mport install xfce4"
#	       -- https://www.midnightbsd.org/documentation/desktop.html
#
# and 2.1 and later ship a default `.xinitrc` that starts Xfce when it is installed, so the session
# file this walk writes is the explicit form of what the release already intends.
walkthrough "midnightbsd 4.0.9 - sshd, Xfce, and a desktop"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var out
  default out/midnightbsd-ssh.qcow2
  from args.out
# THE ACCOUNT IS A VAR AND NOT ONLY THE `user:` SHORTHAND, because the commands below interpolate it
# into a password grep and a sudoers path. MEASURED: with only `user vmuser` the parse fails with
# `"{{ user }}" names "user", which is not in vars`.
var user
  default vmuser
  from args.user
password admin1
ssh_port 2222

step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900

# THE FIRST BOOT LANDS ON THE PROJECT'S OWN WIZARD, AND IT MUST BE LET PAST RATHER THAN ANSWERED.
#
# MEASURED on a disk this repository published, booted with no medium:
#
#	Mounting late filesystems:
#	Starting aged.
#	MidnightBSD FirstBoot Configuration
#	This utility requires an active Internet connection.
#	Set your preferred package mirror? (us.uk, jp)
#
# `firstboot` is the script MidnightBSD's documentation describes, and it will offer to install the
# desktop itself. This walk does that part explicitly further down - a walk that reads its own
# evidence is worth more than one that trusts a wizard's exit status - so the wizard is walked
# through with its defaults, which is RETURN at every prompt, and `no` where it asks to report the
# installation to bsdstats.
#
# IT IS ALSO WHY SSH IS NOT IMMEDIATELY UP: sshd starts, but firstboot owns the console until it
# finishes. The wait below is long for that reason.
step "walk the firstboot wizard with its defaults"
  do
    item
      settle 45
    item
      input ret
      settle 20
    item
      input ret
      settle 15
    item
      input text "no"
    item
      input ret
      settle 15
    item
      input text "no"
    item
      input ret
      settle 20

step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10

step "prove the kernel over ssh"
  ssh "uname -a"

step "prove the account over ssh"
  ssh "id -un"

# THE MACHINE THE INSTALLER WROTE HAS NO NETWORK CONFIGURATION OF ITS OWN, WHICH IS THE SAME THING
# freebsd HAD TO SOLVE: bsdinstall's network menu configures the INSTALLER's runtime, and what it
# wrote into the disk is only the interface name. The interface is brought up here, and DHCP is what
# the tap behind this guest serves.
step "report the interfaces the booted system has"
  ssh "ifconfig -a | head -30"
  timeout 120

step "bring the interface up, because the install walk configured none"
  ssh "sudo sh -c 'ifconfig vtnet0 up 2>/dev/null || true; dhclient vtnet0 >/dev/null 2>&1 || true; ifconfig vtnet0'"
  timeout 240

step "prove the address"
  ssh "ifconfig vtnet0 | grep 'inet '"
  timeout 120

# A BOOTED SYSTEM HAS NO RESOLVER; THE ONE THE WALK WROTE INTO THE CHROOT DURING THE INSTALL IS GONE
# BY THE TIME THIS DISK BOOTS.
step "give the booted system a resolver"
  ssh "sudo sh -c 'printf \"%s\n\" \"nameserver 172.30.0.1\" \"nameserver 1.1.1.1\" > /etc/resolv.conf'; cat /etc/resolv.conf"
  timeout 120

step "prove the mirror is reachable, which is the only thing that makes the install possible"
  ssh "sudo env ASSUME_ALWAYS_YES=yes mport index 2>&1 | tail -5"
  timeout 1200

step "install xorg and xfce, which is the desktop this release names as its own"
  ssh "sudo mport install -A -M xorg xfce4 2>&1 | tail -40"
  timeout 7200

step "prove xfce is installed"
  ssh "ls -l /usr/local/bin/startxfce4 /usr/local/bin/xfce4-session /usr/local/share/xsessions/xfce.desktop 2>&1"
  timeout 180

step "give the account a session that starts xfce"
  ssh "printf '%s\n' '#!/bin/sh' 'exec /usr/local/bin/startxfce4' > ~/.xsession && chmod +x ~/.xsession && cat ~/.xsession"
  timeout 120

step "write the same session for the console, which is what startx reads"
  ssh "printf '%s\n' 'exec /usr/local/bin/startxfce4' > ~/.xinitrc && cat ~/.xinitrc"
  timeout 120

# THE ACCOUNT NEEDS ITS PASSWORD HASH REPLACED WITH ONE PAM WILL ACCEPT. The installer's adduser
# wrote a hash already, but this walk reads it back rather than assuming the pane landed on the
# field it was aiming at - the same proof freebsd's ssh leg makes.
step "prove the account's password is a hash and not a locked field"
  ssh "sh -c 'grep \"^{{ user }}:\" /etc/master.passwd | cut -d: -f2 | cut -c1-3'"
  timeout 120

step "let the account escalate without a password, which is what the session needs"
  ssh "sudo sh -c 'printf \"%s\n\" \"{{ user }} ALL=(ALL) NOPASSWD:ALL\" > /usr/local/etc/sudoers.d/90-{{ user }}\"; sudo chmod 0440 /usr/local/etc/sudoers.d/90-{{ user }}; sudo cat /usr/local/etc/sudoers.d/90-{{ user }}'"
  timeout 180

# THE DISPLAY MANAGER IS WHAT THIS STAGE IS FOR, SO IT IS ASKED TO START RATHER THAN LEFT TO THE
# WIZARD. MidnightBSD's own login manager since 2.1 is mlogind; xdm is in the base system and is
# started from /etc/ttys, which is the path this walk takes because it needs no package of its own.
step "start xdm on the next boot, which is what gives the machine a graphical login"
  ssh "sudo sh -c 'sed -i \"\" -e \"s|^ttyv8.*xdm.*|ttyv8\t\\\"/usr/local/bin/xdm -nodaemon\\\"\txterm\ton secure|\" /etc/ttys; grep -n ttyv8 /etc/ttys'"
  timeout 180

step "tell xdm which session the account gets"
  ssh "sudo sh -c 'mkdir -p /usr/local/lib/X11/xdm; ls /usr/local/lib/X11/xdm'"
  timeout 120

step "flush the writes before the session starts"
  ssh "sudo sync"
  timeout 300

# THE PICTURE IS THE CLAIM. A machine that installed Xfce and then cannot draw it is not a desktop,
# and the installer's own output cannot tell the two apart.
step "the xfce session is drawing on screen"
  repeat
    do
      item
        settle 15
      item "read the screen"
        read
          name desk
    until
      bind ready
      source desk
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      without [[login], [password]]
      words [[xfce], [midnightbsd], [application], [desktop]]
    max 40

step "flush the writes before the machine stops"
  ssh "sudo sync"
  timeout 300

step "press the power button"
  acpi power
  timeout 60

step "wait for the machine to stop"
  wait_until stopped
  timeout 600

step "publish the disk"
  save "{{ out }}"
