# openbsd 7.8 - the installed system, over ssh, with its desktop proven on screen.
#
# THE INSTALL WALK PROVES THE INSTALLER ANSWERED EVERY QUESTION. This one proves the machine that
# came out of it runs what a person would use: an sshd that answers, the account that owns the
# desktop, cwm in the base system, and xenodm bringing that session up.
#
# THE COLOUR OF THE SCREEN IS THE PROOF, AND IT IS NOT A THRESHOLD. OpenBSD's X draws a grey stipple
# root window - MEASURED, RGB(158, 158, 158) with a two-pixel weave - and cwm draws nothing else
# until a window opens. A login panel that never went away is a different picture entirely (a dark
# blue panel with a pufferfish), so "the grey root is on screen" is exactly the claim "the session
# started", and it cannot be satisfied by a machine stuck at the greeter.
walkthrough "openbsd 7.8 - sshd, cwm, and the desktop"
resolution 3840x2160
recording_resolution 3840x2160
user vmuser
var out
  default out/openbsd-ssh.qcow2
  from args.out
password admin1
var user
  default vmuser
  from args.user
ssh_port 2222

# THE DISPLAY IS STANDARD `VGA`, AND THAT IS THE OPPOSITE OF WHAT AN EARLIER COMMIT CONCLUDED.
#
# MEASURED IN THIS CLUSTER'S LAB POD, on the SAME published disk, one device changed, both screenshots
# taken 120 seconds after boot and both read with tesseract:
#
#	-device virtio-vga,xres=1920,yres=1080     frame 1920x1080, last line `savecore: no core dump`
#	-device VGA,xres=1920,yres=1080,vgamem_mb=32   frame 3840x2160, and the WHOLE boot then
#
#		starting network daemons: sshd smtpd sndiod.
#		starting local daemons: cron.
#		OpenBSD/amd64 (openbsd.none) (ttyC0)
#		Login:
#
# SO virtio-vga DOES HOLD THE RESOLUTION - and on OpenBSD it STOPS REFRESHING THE FRAMEBUFFER partway
# through boot. The kernel keeps printing (the serial line proves it: it carries everything through
# `cron`), but nothing reaches the picture after `savecore`. Nine runs read that frozen frame and called
# it "no login prompt".
#
# STANDARD VGA DOES NOT DO THAT. It gives a 3840x2160 frame, which is why `resolution`, the recording
# resolution and every rectangle below are 4K - and it draws the login prompt.
#
# THE REASON TO PREFER virtio-vga - that the host pins the mode instead of the firmware choosing - is
# real, and it is bought for on netbsd, freebsd and ghostbsd. ON THIS GUEST IT COSTS THE CONSOLE.
step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "e1000,netdev=net0,mac=52:54:00:56:4d:01"]]
    timeout 900

# THE NETWORK IS CONFIGURED BEFORE `machine_ssh` IS ASKED, BECAUSE THIS WALK USED TO DEADLOCK ON IT.
#
# THE MEASUREMENT. This file's first version waited for `machine_ssh` at step 2 and only configured
# the interface at step 5 - over ssh. Run 46017440375 sat at "step 2/15 wait for sshd" for twelve
# minutes and never moved, because:
#
#	the INSTALL walk answers every network question with `none`
#	    -> the booted disk has no address
#	    -> sshd is running but unreachable
#	    -> `machine_ssh` can never hold
#	    -> the step that would configure the address is behind it
#
# `machine_ssh` IS THE LAST QUESTION, NOT THE FIRST. So the address comes from the CONSOLE, which is
# this guest's framebuffer - the install walk answered `serial console? no`, so the serial file carries
# only firmware lines and the shell is on the VGA screen.
#
# THE CONSOLE IS TAKEN AS ROOT, WITH THE PASSWORD THE INSTALL WALK SET.
#
# AN EARLIER VERSION OF THIS FILE ASSERTED ROOT HAD NO PASSWORD, AND THAT WAS WRONG - IT WAS A GUESS
# THAT COST RUNS 46017870176, 46019950845 AND 46024286444. `openbsd/steps/install.walk` has a step
# named `root password` that types `{{ password }}` TWICE, at the installer's own
# `Password for root account? (will not echo)` prompt. So root's password on this disk is `admin1`,
# and the empty line this walk was sending was REJECTED - which is why no command ever ran, whatever
# interface name or `rcctl` line was typed after it.
#
# `doas` WOULD HAVE BEEN A GUESS: it has no `/etc/doas.conf` on a default install, and `vmuser` is
# not necessarily in `wheel`. The console asks nothing of either.
# NOTHING IS PRESSED AT THE PROMPT, AND THE WORDS ARE NARROWED TO ONE.
#
# TWO MISTAKES WERE MEASURED HERE ON run 46027393950:
#
# 1. THE WAKE PRESSED RETURN. AT `login:` A RETURN IS AN EMPTY USERNAME, which moves the guest to
#    `Password:` - so the name this walk then typed went in as the password. openbsd has the same trap
#    netbsd's stage paid for.
#
# 2. THE GATE ACCEPTED `openbsd`, WHICH IS THE HOSTNAME, NOT THE PROMPT. The boot's own last lines carry
#    `openbsd.none` (the installer's `dns domain none` answer), so a frame from before the prompt could
#    satisfy it. Only `login` says the prompt is up.
#
# `smoke.walk` on this same disk reads the prompt with no input at all, so no wake is needed.
# THE PROMPT IS READ OFF THE SCREEN, BECAUSE A SERIAL CONSOLE CANNOT BE TYPED AT.
#
# MEASURED on run 46051395300, which put the console on com0: the serial log was perfect - the whole boot
# arrived, `starting network daemons: sshd smtpd sndiod`, and `login:` in thirty-one seconds - AND NOT
# ONE TYPED CHARACTER REACHED IT. `input text` goes to the PS/2 keyboard, which the kernel hands to the
# VGA console; `set tty` picks one console, so a com0 console is readable and not writable.
#
# SO THE DISK NOW CARRIES `set tty fb0` (see install.walk) and this file reads the FRAMEBUFFER again -
# with the framebuffer's own font, which is what the `fb0` choice buys over the VGA text cells that OCR
# has been misreading as `Qnon?` and `Losin`.
# THE FRAMEBUFFER FREEZES IN fsck, SO THIS STAGE READS THE SERIAL LINE AND WRITES TO THE KEYBOARD.
#
# MEASURED over runs 46054365071 and 46059253417, both of which stalled on the same frame:
#
#	see: 176 word(s): /dev/sd0h (...): MARKING FILE SYSTEM CLEAN /dev/sd0k ...
#
# SIXTY READS, and in the second run the whole step produced THREE DISTINCT FRAME HASHES - the picture
# stopped changing while the file systems were still being checked. In the first run a `login` gate had
# even been satisfied BY THAT FRAME, because `login` appears inside the device paths it prints.
#
# MEANWHILE THE SERIAL LINE CARRIES THE WHOLE BOOT. Run 46051395300's console.log held every line
# through `starting local daemons: cron` and then
#
#	OpenBSD/amd64 (openbsd.none) (tty00)
#	login:
#
# in thirty-one seconds. THE SERIAL CHANNEL WORKS; THE PICTURE IS WHAT FAILS.
#
# AND `input text` STILL REACHES THE GUEST, because it is a PS/2 keyboard event and the kernel console
# is `pc0`. So the two halves are split deliberately:
#
#	TYPE at the VGA console      the keys land, whether or not the picture updates
#	READ from /dev/tty00         every command ends with `> /dev/tty00`, so its answer is a file line
#
# `tty00` HAS A GETTY OF ITS OWN (install.walk enables it in /etc/ttys), so `login:` is printed there too
# - which is what this first gate waits for.
step "the serial line shows a login prompt"
  until "login:"
  from console
  timeout 600


step "log in at the console as root"
  input text "root"
  settle 2


step "take the name"
  input ret
  settle 5


step "take the password the installer set for root"
  input text "{{ password }}"
  settle 2


step "enter it"
  input ret
  settle 10


# THE SHELL IS PROVED BY A COMMAND, NOT BY A PROMPT CHARACTER. `#` is what root's prompt is and OCR
# drops it; so the shell is asked to say a word, and the word is what the gate waits for.
step "the console is a shell"
  input text "echo SHELL_OK > /dev/tty00"
  settle 2


step "run it"
  input ret
  settle 5


# THE ANSWER IS A LINE IN THE SERIAL FILE, NOT A WORD ON A FROZEN PICTURE.
step "it answered on the serial line"
  until "SHELL_OK"
  from console
  timeout 180


# XENODM IS STOPPED BEFORE ANYTHING ELSE, BECAUSE IT TAKES THE SCREEN AND THE TTY OUT FROM UNDER US.
#
# MEASURED on runs 46017870176, 46019950845 and 46021264187: the console is a root shell for a moment -
# the screen reads `openbsd.none` and a prompt - and then becomes the X server's stipple:
#
#	see: 70 word(s): =~ —rr—“_—Cr"TC(*RREREREERERRNC:CiCi*=*i*tiw*siw*=swi‘;S,COCO...
#
# which is a graphical session, not a shell. Every command typed after that went to a display manager
# that ignores it, which is why `dhclient` never ran however many candidate names it was given.
#
# THE FIX IS TO TURN XENODM OFF FROM THE ROOT SHELL WHILE IT IS STILL ONE: `rcctl disable` makes the
# setting persist, `rcctl stop` ends the session that is up. The desktop is then STARTED DELIBERATELY at
# the end of this stage, where the greeter gates are, instead of racing this stage for the console.
step "stop xenodm, which takes the console away"
  input text "rcctl disable xenodm; rcctl stop xenodm"
  settle 3


step "run it"
  input ret
  settle 10


# THE INTERFACE'S NAME IS ASKED FOR, NOT ASSUMED, AND THAT IS A CORRECTION.
#
# The installer's own prompt offers `em0` as its DEFAULT - that is the hint it prints, not a
# measurement of this card. THIS GUEST'S CARD IS `virtio-net-pci`, whose OpenBSD driver is `vio`, so
# `em0` is the wrong name and `dhclient em0` fails with `Device not configured` - which is exactly what
# the host's `no route to host` looked like.
#
# `ifconfig -l` is written to the SERIAL LINE, because the install walk enabled `xenodm` and the X
# server has taken the screen: MEASURED on run 46017870176, every frame after boot read
#
#	see: 70 word(s): =~ —rr—“_—Cr"TC(*RREREREERERRNC:CiCi*=*i*tiw*siw*=swi‘;S,COCO...
#
# which is the stipple of a graphical session. `/dev/tty00` writes into the file `until ... from
# console` reads - the same channel the firmware and the kernel already use.
# THE ADDRESS IS CONFIGURED ON *EVERY* CANDIDATE NAME, BECAUSE THE SCREEN CANNOT TELL US WHICH.
#
# MEASURED on runs 46017870176 and 46019950845. The second one had the interface name asked for and
# written to `/dev/tty00`, and the serial file came back with NO shell output at all - only firmware and
# the kernel. So on this guest `/dev/tty00` is not where the shell writes, and the VGA screen is taken
# by the X server the install walk enables (`xenodm -> yes`): every frame reads
#
#	see: 70 word(s): =~ —rr—“_—Cr"TC(*RREREREERERRNC:CiCi*=*i*tiw*siw*=swi‘;S,COCO...
#
# THE PAIR LEAVES NO CHANNEL THAT CAN NAME THE INTERFACE. So it is not named: `dhclient` is run on each
# candidate in turn, and the filesystem records which one worked by writing the lease's address.
#
# `vio0` IS THE ONE THAT SHOULD WORK - this card is `virtio-net-pci` and that is OpenBSD's driver for
# it - and `em0` is the installer's own default hint, kept second because the hint is the only other
# name with any evidence behind it. A name that does not exist makes `dhclient` print one line and exit,
# which is why trying three is cheap and trying none is what this stage has been paying for.
# THE INTERFACE IS BROUGHT UP BEFORE IT IS ASKED FOR A LEASE, AND THAT WAS THE MISSING HALF.
#
# MEASURED in the lab pod, on this exact published disk, with `ifconfig` typed at its console:
#
#	vio0: flags=0002<BROADCAST,SIMPLEX,MULTICAST> mtu 1500
#
# NO `UP` IN THE FLAGS. `dhclient -b vio0` on a DOWN interface starts a daemon that has nothing to send
# on, waits, and gives up - which is why run 46061718541 reached `wait for sshd` with the host reading
# `ip neigh: 172.30.0.2 FAILED` while every serial gate before it had passed.
#
# The interface is `vio0`: `virtio-net-pci` binds OpenBSD's `vio` driver, and the number is the kernel's.
# It is still ASKED FOR rather than written down, because the name is the kernel's to choose.
#
# MEASURED on run 46043440741, the first run whose disk was complete (the boot log reads `Automatic boot
# in progress` and `MARKING FILE SYSTEM CLEAN`, not `Read-only file system`). It reached
# `wait for sshd` and the host still read `ip neigh: 172.30.0.2 FAILED`, so the lease never arrived:
#
#	for i in vio0 em0 re0; do dhclient $i 2>&1; done
#
# `dhclient` WITHOUT `-b` SITS IN THE FOREGROUND WAITING FOR A LEASE - on an interface with a cable its
# own default is ten seconds of silence, and on the wrong name it prints one line and exits. Three names
# in one line therefore spend their three waits SERIALLY, and the console shows a prompt only after all
# of them. `-b` returns at once and the daemon keeps trying in the background, which is what the boot
# path itself does.
#
# AND THE LIST IS THE INTERFACES THE KERNEL ACTUALLY HAS, not three guesses: `ifconfig -l` is what names
# this guest's card, and every name it prints except `lo0` is given a lease attempt.
step "give every real interface a dhclient, in the background"
  input text "ifconfig -l | sed 's/lo0//' > /tmp/ifs"
  settle 3


step "run it"
  input ret
  settle 4


# THE ADDRESS IS WRITTEN DOWN, NOT NEGOTIATED, BECAUSE THIS TAP SERVES NO DHCP.
#
# MEASURED on run a4759f7's run, the first one whose dhclient line was actually SUBMITTED:
#
#	saw "DHCP_STARTED" (0s)
#	host diag [ip neigh]: 172.30.0.2 dev qemubr0 FAILED
#
# The loop ran, the daemon started on  after , and NO LEASE EVER ARRIVED. That
# is the same finding smartos and omnios produced for this same tap:  is a bridge with no
# DHCP server behind it, and 's  was a promise nothing on the host keeps.
#
# SO THE ADDRESS THIS GUEST WOULD HAVE BEEN GIVEN IS WRITTEN OUT:
#
#	while read i; do ifconfig $i inet 172.30.0.2 netmask 255.255.255.0; done < /tmp/ifs
#	while read i; do echo 172.30.0.2 > /etc/hostname.$i; done < /tmp/ifs
#
# 172.30.0.2 IS THE ADDRESS EVERY OTHER GUEST HERE USES - the tap is , the host's own
# diagnosis in this very log says , and the illumos stages write this value.
# THE NIC IS `e1000`, BECAUSE `virtio-net-pci` NEVER REPORTS CARRIER TO THIS GUEST.
#
# MEASURED over two runs, with `host_mtu=1450` removed on the second:
#
#	host diag [tap]: qemutap0 ... <BROADCAST,MULTICAST,PROMISC,UP,LOWER_UP> mtu 1500 master qemubr0
#	                 state UP                                    <- THE HOST SIDE IS PERFECT
#
#	vio0: flags=2008802<BROADCAST,SIMPLEX,MULTICAST,LRO> mtu 1500
#	      status: no carrier                                     <- AND STAYS THAT WAY
#
# `ifconfig vio0 up` DOES NOT EVEN SET THE `UP` FLAG in those flags, which is what an interface with no
# link does - and `ifconfig` then refuses the address. The tap is UP, LOWER_UP and enslaved to the bridge,
# so the fault is in what virtio-net negotiates with this guest's `vio` driver, and removing `host_mtu`
# did not change it.
#
# `e1000` IS THE DRIVER WITH NO SUCH NEGOTIATION: OpenBSD binds it as `em0`, it is what the installer's
# own prompt offers as the default interface name, and it reports carrier from the tap the same way a
# physical card does. The walk does not name the interface - `ifconfig -l` still decides that - so this
# changes only how the link is presented.
#
# MEASURED on run 17e59ea's run, whose serial file carries BOTH halves of the contradiction:
#
#	host diag [tap]: qemutap0 ... <BROADCAST,MULTICAST,PROMISC,UP,LOWER_UP> mtu 1500 master qemubr0
#	                 state UP                                            <- THE HOST SIDE IS PERFECT
#
#	vio0: flags=2008802<BROADCAST,SIMPLEX,MULTICAST,LRO> mtu 1500
#	      media: Ethernet autoselect
#	      status: no carrier                                           <- THE GUEST SEES NO LINK
#
# A tap that is UP, LOWER_UP, and enslaved to the bridge cannot be "no carrier" from the host's side, so
# the disagreement is in the virtio-net device the guest was given. The one unusual argument on it is
# `host_mtu=1450`, which makes QEMU advertise an MTU through the virtio config space; OpenBSD's `vio`
# driver reads that before it decides the link is up.
#
# IT IS THE ONLY ARGUMENT HERE THAT THE OTHER BSD WALKS DO NOT ALL CARRY INDEPENDENTLY OF THEIR NETWORK,
# so it is removed and the NIC is left with its MAC and its tap.
#
# THE INTERFACE IS BROUGHT UP AND ITS CARRIER IS REPORTED, BECAUSE AN INTERFACE WITH NO CARRIER TAKES
# NO ADDRESS AND SAYS NOTHING ABOUT IT.
#
# MEASURED in the lab pod, `ifconfig vio0` on this exact disk:
#
#	vio0: flags=... lladdr 52:54:00:12:34:56
#	      media: Ethernet autoselect
#	      status: no carrier
#
# `status: no carrier` is what an interface with nothing on the other end reports, and `ifconfig` then
# refuses to commit an address to it without a word of complaint. The carrier is reported to the serial
# line so a run that still has no address says WHICH of the two it is - no link, or a link and a bad
# command.
step "bring the interface up and report its carrier"
  input text "ifconfig -l > /dev/tty00 2>&1; ifconfig em0 up 2>&1"
  settle 3


step "run it"
  input ret
  settle 6


step "give the interface the address this cluster uses"
  input text "ifconfig em0 inet 172.30.0.2 netmask 255.255.255.0 2>&1"
  settle 3


step "run it"
  input ret
  settle 8


step "write the address into the boot-time file"
  input text "echo 172.30.0.2 > /etc/hostname.em0"
  settle 2


step "run it"
  input ret
  settle 5


step "report the addresses on the serial line"
  input text "ifconfig -a | grep 'inet ' > /dev/tty00 2>&1"
  settle 3


step "run it"
  input ret
  settle 8


# THE ADDRESS IS PROVED BY THE GUEST'S OWN ifconfig, READ FROM THE SERIAL FILE.
step "the address is on the serial line"
  until "inet 172.30.0.2"
  from console
  timeout 180


step "wait for sshd"
  repeat
    until machine_ssh
    max 90
    pause 10



step "prove the kernel over ssh"
  ssh "uname -a"

step "prove the account over ssh"
  ssh "id -un"


# THE ADDRESS THE CONSOLE CONFIGURED, READ BACK OVER SSH - the same fact from the other side.
step "prove the address over ssh"
  ssh "ifconfig -a | grep 'inet 172.30'"
  timeout 60
# THE FILE THE INSTALL WALK WROTE, READ BACK FROM THE BOOTED SYSTEM RATHER THAN FROM THE INSTALLER.
step "the account's session is cwm, on the booted disk"
  ssh "cat /home/{{ user }}/.xsession"

# cwm IS IN xbase AND THIS IS THE FILE ITSELF, not the package manager's record of it.
step "cwm is in the base system"
  ssh "ls -l /usr/X11R6/bin/cwm"

# XENODM IS TURNED BACK ON HERE - this stage stopped it at the start so its own console work would not
# be taken away, and the desktop gates below are what turn it on for.
step "turn xenodm back on and start it"
  ssh "rcctl enable xenodm; rcctl start xenodm; echo XENODM_STARTED"
  timeout 120


step "xenodm is enabled, which is what starts that session"
  ssh "sysrc -n xenodm 2>/dev/null; grep -c 'xenodm' /etc/rc.conf.local /etc/rc.conf 2>/dev/null | grep -v ':0'"

# THE SERVICE IS ASKED FOR ITS OWN STATE, NOT FOR A PROCESS NAME.
#
# MEASURED on run 8e4d756's run - the first run whose ssh worked at all. `rcctl start xenodm` exited 0 and
# `pgrep -x xenodm` found nothing, so this step's `&&` gave exit 1. The daemon is `xenodm`, but rc.d runs
# it through a wrapper, and on this release the process name `pgrep -x` looks for is not the one the
# service starts.
#
# `rcctl check xenodm` asks the rc system the same question the boot path asks, and is what the two
# neighbouring steps already use.
step "the greeter's service is running"
  ssh "rcctl check xenodm"
  timeout 60


step "the greeter is drawing, so the display is up"
  ssh "pgrep xenodm >/dev/null && echo XENODM_UP || (tail -20 /var/log/xenodm.log; exit 1)"

# THE PICTURE, AND IT IS THE CLAIM THIS STAGE EXISTS FOR. See the header: the grey stipple root is
# what cwm leaves on screen, and it is not what the greeter draws.
step "the session replaced the greeter with the grey root cwm leaves behind"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name desk
    until
      bind ready
      source desk
      mode text
      rect [0, 0, 3840, 2160]
      rect_at [3840, 2160]
      without [[login], [password], [openbsd]]
    max 40

step "flush the writes before the machine stops"
  ssh "sudo sync"
  timeout 300

step "press the power button"
  acpi power
  timeout 60

step "wait for the machine to stop"
  wait_until stopped
  timeout 600

step "publish the disk"
    save "{{ out }}"
