# ghostbsd 26.3 - the first-boot wizard answered, sshd, and the desktop it lands on.
#
# READ `ghostbsd/steps/install.walk` FIRST. GBI ends with "Installation completed" and the machine is
# killed there - and the published disk boots into "GhostBSD Initial Setup", NOT into a usable system:
#
#	MEASURED in the lab pod on the published `bsd-ghostbsd-install` disk:
#
#		GhostBSD Initial Setup
#		Please select your language:
#		English / Afrikaans / ... / Next
#
# NO ACCOUNT, NO PASSWORD AND NO sshd EXIST UNTIL THAT WIZARD IS ANSWERED. That is what this stage is
# for: it is the `firstboot` half of the install, and until it runs the disk has no `vmuser` to log in as.
#
# THE WIZARD IS GTK, SO IT IS CLICKED. `click_at [1920, 1080]` on every click lets the engine rescale,
# and `Next` sits at the same place on every page - (1330, 782) in the 1920x1080 frame, measured with
# tesseract's own bounding box:
#
#	tesseract w1.png - tsv | awk -F'\t' '$12=="Next" {print $7,$8,$9,$10}'
#	1316 777 28 9
#
# EVERY PAGE IS WAITED FOR, NOT TIMED. A click that lands before the page is drawn goes nowhere, and a
# walk that clicks blindly reports a wizard it never answered.
walkthrough "ghostbsd 26.3 - the first-boot wizard, sshd, and the desktop"
resolution 1920x1080
recording_resolution 1920x1080
user root
var out
  default out/ghostbsd-ssh.qcow2
  from args.out
password admin1
var user
  default root
  from args.user
ssh_port 2222


step "boot the published disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-m", "8192"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "e1000,netdev=net0,mac=52:54:00:56:4d:01"]]
    timeout 900


# THE WIZARD'S FIRST PAGE, WHICH IS ALSO THE PROOF THE DISK IS THE ONE THE INSTALL LEFT.
step "the first-boot wizard is up"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name wiz
    until
      bind up
      source wiz
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[ghostbsd, initial, setup], [please, select, your, language]]
    max 60


# THE WIZARD'S PAGES, EACH WAITED FOR AND THEN ADVANCED.
#
# `Next` IS AT THE SAME PLACE ON EVERY PAGE because the wizard is a GtkNotebook with one button box -
# measured at (1330, 782) in the 1920x1080 frame.
# THE WIZARD'S PAGES ARE ADVANCED ONE AT A TIME, WITHOUT ASSUMING HOW MANY THERE ARE.
#
# MEASURED on the first run of this stage: the wizard went
#
#	GhostBSD Initial Setup -> Please select your language
#	                      -> Network / "Network card connected to the internet"
#	                      -> (and stayed there, because this walk expected an account page next)
#
# SO EACH PAGE IS WAITED FOR BY WHAT IT SAYS, ADVANCED, AND THE NEXT ONE IS READ - a fixed sequence of
# three clicks was wrong about the order, and a click that lands on a page that has not drawn goes
# nowhere.
#
# `Next` IS AT (1330, 782) ON EVERY PAGE: measured with tesseract's bounding box on the first page,
# `1316 777 28 9`, and the wizard is one GtkNotebook with a single button box.
# THE WIZARD'S ONLY ACCOUNT PAGE IS THE ROOT PASSWORD, AND THAT IS WHAT IT SAYS.
#
# MEASURED on the second run of this stage, which reached the page and read it:
#
#	Admin User
#	The initial root password will be set to ...
#
# GhostBSD's first-boot wizard does NOT create a normal user - unlike FreeBSD's `adduser`, which the
# freebsd stage drives. So there is no `vmuser` to log in as, and the account this stage uses is `root`.
#
# THE PAGES BEFORE IT ARE ADVANCED BY READING EACH ONE, because the order was measured to be
#
#	GhostBSD Initial Setup -> Keyboard -> Time Zone -> Network -> Admin User
#
# and a fixed three clicks was wrong about it.
step "advance the wizard to the account page"
  repeat
    do
      item "read what the page says"
        read
          name page
      item "press Next"
        input 1330 782
        click_at [1920, 1080]
        settle 6
    until
      bind up
      source page
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[root, password], [admin, user]]
    max 20


# THE ROOT PASSWORD IS TYPED INTO WHATEVER FIELD HAS FOCUS, AND TAB MOVES BETWEEN THEM.
#
# MEASURED on the third run: the wizard reached this page and STOPPED, with
#
#	see: 34 word(s): Admin User e e The initial root password will be set to ...
#
# because the two clicks this walk made at (960, 480) and (960, 530) landed on nothing - the page's own
# layout is not the column the coordinates assumed, and a click that misses an entry leaves the caret
# where it was.
#
# TAB IS THE WIDGET'S OWN ROUTE: the page is a GTK form, and focus moves between its entries with Tab just
# as it does for a person. The first Tab from the page's initial focus reaches the first password field,
# the second the confirmation, and Return submits the page.
# THE PAGE HAS FOUR FIELDS, AND THEIR POSITIONS ARE MEASURED, NOT GUESSED.
#
# MEASURED from the run's own recording, read with `tesseract frame.png - tsv`:
#
#	663 400 61 10  Realname
#	662 447 63  9  Username       835 446 42 10  admint     <- a value was already here
#	665 538 56 10  Password
#	645 584 33 13  Verify
#
# SO THE FIELDS ARE A COLUMN OF LABELS AT x~660 WITH THEIR ENTRIES TO THE RIGHT, one line each, and this
# page CREATES AN ADMIN USER whose password also becomes root's - "The initial root password will be set
# to the admin user password." The account this stage then logs in as is the one named here.
#
# THE EARLIER VERSION TABBED BLINDLY and left `admint` in Username, which is why the page never advanced:
# a mismatched or absent confirmation is what a form refuses to accept.
step "the account's real name"
  input 960 400
  click_at [1920, 1080]
  settle 2


step "type it"
  input text "GhostBSD User"
  settle 2


step "the account's user name"
  input 960 447
  click_at [1920, 1080]
  settle 2


step "clear whatever was there and type the name"
  input text "{{ user }}"
  settle 2


step "the account's password"
  input 960 538
  click_at [1920, 1080]
  settle 2


step "type the password"
  input text "{{ password }}"
  settle 2


step "the confirmation"
  input 960 584
  click_at [1920, 1080]
  settle 2


step "type it again"
  input text "{{ password }}"
  settle 3


# THE BUTTON IS BELOW THE FORM; Return from the last field may only move focus.
step "submit the page"
  input 1330 782
  click_at [1920, 1080]
  settle 10



step "the desktop the wizard leaves behind is up"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name desk
    until
      bind up
      source desk
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[applications], [places], [ghostbsd]]
    max 60



# THE NETWORK IS WRITTEN DOWN, NOT NEGOTIATED - THE FIFTH STAGE IN THIS REPOSITORY TO FIND THAT.
#
# The tap is `172.30.0.1/24` and serves no DHCP. GhostBSD is FreeBSD underneath, so the interface name is
# the kernel's (`em0` for the e1000 this walk gives it); `ifconfig -l` answers it, FreeBSD's `ifconfig`
# takes a CIDR suffix, and 172.30.0.2 is the address every guest here uses.
step "give every real interface the address this cluster uses"
  input text "for i in $(ifconfig -l); do test $i = lo0 || ifconfig $i inet 172.30.0.2/24; done"
  settle 3


step "run it"
  input ret
  settle 8


step "the address the guest reports"
  input text "ifconfig -a | grep 'inet '"
  settle 2


step "run it"
  input ret
  settle 6


# THE TEXT CONSOLE IS TAKEN FIRST, BECAUSE THE WIZARD LEAVES A DISPLAY MANAGER ON THE ONE WE HAVE.
#
# MEASURED on the seventh run: after the wizard finished, the screen was
#
#	see: 8 word(s): ghostbsd-ghostbsd-pc ... GhostBSD User Password
#
# - a display manager's login panel. Every command this walk typed after that went to it, not to a shell,
# which is why `sysrc sshd_enable=YES` reported success and sshd never started.
#
# `Ctrl+Alt+F1` IS THE STANDARD WAY BACK TO A VIRTUAL TERMINAL on a FreeBSD console, and the login prompt
# it brings is the one this walk logs in at.
# THE DESKTOP RUNS AS AN ADMIN USER, AND sshd IS STARTED BY ASKING FOR ROOT ONCE.
#
# MEASURED on the seventh run: the wizard finished and the desktop came up, while
#
#	host diag [icmp guest]: ICMP_OK 2/2
#	host diag [ip neigh]: 172.30.0.2 ... REACHABLE
#
# - THE NETWORK WAS PERFECT and `machine_ssh` still read false, because sshd was never started. The
# `sysrc sshd_enable=YES` that was meant to do it ran as the wizard's OWN NON-ROOT USER and had nowhere to
# write.
#
# `sudo -S` TAKES THE PASSWORD ON STDIN, which is the only way to escalate over a command channel with no
# tty - the same reason doas needed `nopass` on openbsd.
# sshd IS ENABLED BY THE ADMIN USER THIS WIZARD CREATED, AND THE STAGE LOGS IN AS THAT USER.
#
# MEASURED on the seventh run: the wizard finished, the desktop came up, and
#
#	host diag [icmp guest]: ICMP_OK 2/2
#	host diag [ip neigh]: 172.30.0.2 ... REACHABLE
#
# - THE NETWORK WAS PERFECT AND `machine_ssh` STILL READ FALSE, because sshd was never started. The
# `sysrc sshd_enable=YES` that was meant to do it ran as the wizard's own NON-ROOT user and had nowhere to
# write.
#
# `sudo -S` TAKES THE PASSWORD ON STDIN - the only way to escalate over a command channel with no tty, and
# the same reason openbsd's doas needed `nopass`. The admin user the wizard created is in `wheel`, which is
# what `sudo` checks.
#
# ROOT'S OWN PASSWORD WAS SET TO THE SAME VALUE by that page ("The initial root password will be set to
# the admin user password"), so `PermitRootLogin` does not have to be touched: the stage stays the admin
# user and escalates only where it must.
step "enable sshd, with the password the wizard set"
  input text "echo {{ password }} | sudo -S sysrc sshd_enable=YES"
  settle 2


step "run it"
  input ret
  settle 5


step "start it"
  input text "echo {{ password }} | sudo -S service sshd start"
  settle 2


step "run it"
  input ret
  settle 10


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"


step "prove the account over ssh"
  ssh "id -un"


step "prove the address over ssh"
  ssh "ifconfig -a | grep 'inet 172.30'"
  timeout 60


# THE DESKTOP, WHICH THE WIZARD'S OWN SESSION LANDS ON. MATE is GhostBSD's default.
step "the desktop is running"
  ssh "pgrep -x marco >/dev/null && echo MATE_UP"
  timeout 60


step "flush the writes before the machine stops"
  ssh "sync"
  timeout 120


step "shut the machine down"
  ssh "shutdown -p now"
  timeout 300


step "publish the disk"
  save "{{ out }}"
