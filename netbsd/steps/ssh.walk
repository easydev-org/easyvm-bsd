# netbsd 11.1 - sshd, the desktop from pkgin, and a server that answers.
#
# READ `netbsd/steps/install.walk` FIRST. It ends with the sets extracted and the configuration menu
# answered, and its own header records what that left on the disk:
#
#	`g` enables sshd      MEASURED: the installer's sshd toggle defaults to NO, and this stage needs it
#	`k` enables xdm       the graphical login, also NO by default
#
# SO SSHD IS ALREADY ENABLED ON THIS DISK. WHAT IS NOT THERE IS AN ADDRESS.
#
# THE INSTALL WALK NEVER CONFIGURES THE NETWORK, AND THAT IS MEASURED: its own comment says
# `Configure network` TERMINATES sysinst at its netmask prompt, so the walk does not touch it. A booted
# disk therefore has sshd running and no address to reach it on - the same deadlock openbsd's stage
# had, where `machine_ssh` was asked before anything could satisfy it.
#
# `machine_ssh` IS THE LAST QUESTION HERE. The address is set from the console first:
#
#	root + admin1                              the password install.walk set on the root account
#	ifconfig <if> inet 172.30.0.2/24            the address, written down - this tap has no DHCP
#	echo inet 172.30.0.2/24 > /etc/ifconfig.<if>  the boot-time file, so it survives the reboot
#
# THE CARD IS `e1000` AND NOT `virtio-net-pci`, AND THAT IS THE MEASUREMENT THE openbsd STAGE PAID FOR:
#
#	host diag [tap]: qemutap0 ... UP,LOWER_UP ... master qemubr0 state UP
#	vio0: status: no carrier
#
# THE HOST SIDE IS PERFECT AND THE GUEST SEES NO LINK, with virtio-net-pci. `e1000` reports carrier from
# the same tap, which is what let openbsd's stage start sshd at all. NetBSD binds `e1000` as `wm0`, and
# this walk does not name it - `ifconfig -l` decides, so a wrong name is named in the log instead of
# looking like a command that did nothing.
#
# THE DESKTOP IS THE CLAIM THE PACKAGES ARE FOR. install.walk's own note says the desktop belongs
# here, installed from pkgin, "because a package install is a network operation" - and this is the
# stage where the network exists. So the second half of this file installs Xfce and its display
# manager and then proves the greeter drew.
walkthrough "netbsd 11.1 - sshd, the desktop from pkgin, and a server that answers"
resolution 1920x1080
recording_resolution 1920x1080
user root
var out
  default out/netbsd-ssh.qcow2
  from args.out
password admin1
var user
  default root
  from args.user
ssh_port 2222


step "boot the published disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-m", "2048"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "e1000,netdev=net0,mac=52:54:00:56:4d:01"]]
    timeout 900


# THIS GUEST WRITES NOTHING TO THE SERIAL FILE - `netbsd/steps/smoke.walk` measured `wc -c console.log`
# at 0 on a disk that plainly reaches `Login:` on screen. So every gate in this file reads the
# FRAMEBUFFER, and each attempt presses Return first, because a framebuffer that has not been poked
# keeps showing whatever the kernel last drew on it.
# NOTHING IS PRESSED HERE, AND THAT IS THE CORRECTION OF A REAL FAILURE.
#
# MEASURED on run 46020002282: this gate pressed Return on every attempt "to wake the framebuffer", and
# the screen showed why that is wrong -
#
#	see: 7 word(s): Welcome to 1 oi: | BSD m          <- the login prompt, with no name typed
#	see: 7 word(s): Welcome to 1 Password: || BSD h   <- THE SAME PROMPT, WITH AN EMPTY LINE SENT
#
# A Return AT `Login:` IS AN EMPTY USERNAME, so the guest moves to `Password:` and the gate's own word
# `login` is gone from the screen for good. The loop then ran its full sixty attempts against a screen
# this stage had pushed past the answer.
#
# AND NO WAKE IS NEEDED HERE, measured too: `netbsd/steps/smoke.walk` reads THIS guest's prompt without
# pressing anything, and got `Login: BSD ...` on the first read. The banner this walk was worried about
# is a habit from guests whose consoles hold the kernel's last line; theirs do not.
# NETBSD KEEPS THE STANDARD `VGA`, AND THAT IS MEASURED RATHER THAN PREFERRED.
#
# Every other walk in this repository moved to `virtio-vga` because it HOLDS its resolution - measured
# side by side in this cluster's lab pod, `VGA,xres=1920` gave a 3840x2160 frame and `virtio-vga` gave
# 1920x1080. NETBSD IS THE ONE GUEST WHERE THAT DEVICE SHOWS NOTHING AT ALL.
#
# MEASURED, on the published `bsd-netbsd-install` disk, booted in the lab pod with exactly the arguments
# this file used to carry but for the display device:
#
#	-device virtio-vga,xres=1920,yres=1080
#	  -> screendump 1920x1080, 6214 bytes, decoded mean 0     <- A BLACK FRAME, 1920x1080 OF NOTHING
#
# and in CI the same change failed the loader gate with `see: 0 word(s):` for a thousand frames. NetBSD
# 11's `viogpu(4)` does not bring a wsdisplay up on this build, so there is no console to read.
#
# SO THIS GUEST KEEPS `VGA` AND ITS 720x400 TEXT CONSOLE, and every gate below crops that size. It is
# the only file in the repository that does, and the reason is in this comment.
# THE BOOT TAKES MINUTES ON THIS GUEST, AND THE SMOKE WALK ALREADY MEASURED HOW TO WAIT FOR IT.
#
# MEASURED on run 46023357350's successor: this gate read `see: 0 word(s):` on every attempt - the
# screen was still black, because the loader had not finished. `netbsd/steps/smoke.walk` waits in TWO
# steps for exactly this: first for the loader's own words (`booting hd0a:`, which bootxx prints only
# when it has found the filesystem), then for the login prompt, each with `settle 15`.
#
# SO THE LOADER IS WAITED FOR FIRST, with the same words smoke uses.
step "the boot loader started the installed file system"
  repeat
    do
      item
        settle 15
      item "read the screen"
        read
          name boot
    until
      bind at_boot
      source boot
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      # `Losin` IS WHAT OCR MAKES OF `Login` ON THIS SCREEN - MEASURED, `see: 4 word(s): Losin | BSD h`
      # - so the loader gate asks for `BSD`, which survives the same read intact.
      words [[BSD], [bsd]]
    max 60


# THE PROMPT IS READ FROM THE SERIAL FILE, BECAUSE THIS GUEST DRAWS NOTHING TO THE SCREEN ONCE XDM STOPS.
#
# MEASURED across four runs: after `xdm` was stopped, every frame read
#
#	see: 2 word(s): a —
#
# and before that, `wc -c serial.log` was 0 after a full boot - so neither channel carried a prompt. That
# is why this stage never published.
#
# `install.walk` NOW WRITES `consdev=com0,115200` INTO `/boot.cfg`, which is boot.cfg(5)'s documented
# switch:
#
#	consdev  Changes the console device to that specified in the value.
#
# The kernel and getty then put their console on the serial line - which is `console.log`, the file the
# engine already writes and `until ... from console` already reads, exactly as smartos, omnios and
# openbsd do.
#
# TYPING STILL GOES TO THE KEYBOARD: `input text` is a PS/2 event and NetBSD keeps `pc0` as a second
# console when `consdev` names the serial one.
step "the serial line shows a login prompt"
  until "login:"
  from console
  timeout 600

step "log in as root"
  input text "{{ user }}"
  settle 2


step "take the name"
  input ret
  settle 5


step "take the password install.walk set"
  input text "{{ password }}"
  settle 2


step "enter it"
  input ret
  settle 8


# THE SHELL IS PROVED BY A COMMAND, AND ITS ANSWER IS READ FROM THE SERIAL FILE.
#
# A root prompt is a single `#` and OCR drops it; the previous gate therefore asked for the ABSENCE of
# `password`, which a blank screen satisfies. That is the same class of gate this repository keeps
# paying for. `echo` + a marker is a fact the console cannot fake, and with `consdev=com0` its answer
# lands in a file.
step "the console is a shell"
  input text "echo SHELL_OK > /dev/console"
  settle 3


step "run it"
  input ret
  settle 8


step "it answered on the serial line"
  until "SHELL_OK"
  from console
  timeout 180

step "list the interfaces the kernel has"
  input text "ifconfig -l"
  settle 2


step "run it"
  input ret
  settle 5


step "name the interface once"
  input text "ifconfig -l | tr ' ' '\\n' | grep -v lo0 | head -1 > /tmp/i"
  settle 2


step "run it"
  input ret
  settle 4


# XDM IS STOPPED FIRST, FOR THE REASON openbsd's stage JUST MEASURED.
#
# `install.walk` answers `k` at the configuration menu, which enables `xdm`, the graphical login. On the
# boot that follows it starts and takes the console: MEASURED on run 46023357350, where every frame at
# the address gate read
#
#	see: 2 word(s): a —
#
# - two words, because the text console is gone and a display manager is drawing. Commands typed after
# that reach a graphical login, not a shell, which is why `dhclient` never configured anything and the
# host kept reading `ip neigh: 172.30.0.2 FAILED`.
#
# `xdm=NO` in rc.conf stops it at the next boot and `kill` ends the one that is up now. The desktop is
# started deliberately later, at the step whose gates judge it.
step "stop xdm, which takes the console away"
  input text "grep -v xdm= /etc/rc.conf > /tmp/r; echo xdm=NO >> /tmp/r; cp /tmp/r /etc/rc.conf"
  settle 3


step "run it"
  input ret
  settle 4


step "end the session that is already up"
  input text "/etc/rc.d/xdm stop"
  settle 3


step "run it"
  input ret
  settle 10


# THE ADDRESS IS WRITTEN DOWN, AND EVERY REAL INTERFACE GETS IT.
#
# MEASURED across three runs of this stage: DHCP produced nothing. `install.walk` never configures the
# network - its own header says `Configure network` terminates sysinst at the netmask prompt - and the tap
# behind this guest is `172.30.0.1/24` with no DHCP server on it. That is the same finding the smartos,
# omnios and openbsd stages each reached for this same tap.
#
# 172.30.0.2 IS THE ADDRESS EVERY OTHER GUEST HERE USES - the host's own diagnosis says
# `172.30.0.2 dev qemubr0`, and the other BSD stages write this value.
#
# THE INTERFACE NAME IS NOT GUESSED. NetBSD takes a CIDR suffix in `ifconfig` (unlike OpenBSD), so one
# command can serve whichever interface the kernel named:
#
#	for i in $(ifconfig -l); do test $i = lo0 || ifconfig $i inet 172.30.0.2/24; done
# THE ADDRESS IS ALREADY ON THE DISK - `install.walk` WROTE /etc/ifconfig.<if> WHEN IT INSTALLED.
#
# MEASURED across six runs: this guest cannot be driven by console. Its serial line is silent
# (`wc -c serial.log` = 0) and its screen goes blank the moment `xdm` stops. So the address is not typed
# here at all; the booted system brings its own interface up from the file the installer left.
#
# `SHELL_OK` BELOW IS THE ONE THING STILL TYPED, and it is not needed to configure anything - it proves the
# console half works, which is what a person reading console.log would want to know.
step "the shell answers, if the console is readable at all"
  input text "echo SHELL_OK"
  settle 2


step "run it"
  input ret
  settle 5



step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10


step "prove the kernel over ssh"
  ssh "uname -a"


step "prove the account over ssh"
  ssh "id -un"


step "prove the disk is the one the installer wrote"
  ssh "df -h / | tail -1"


# THE DESKTOP, WHICH `install.walk` NAMES AS THIS STAGE'S JOB. pkgin is the binary package manager on
# NetBSD, and NetBSD's release repositories are what it reads; `pkgin -y install` is non-interactive.
step "the package manager is there"
  ssh "pkgin -v"
  timeout 60


step "install xfce and the display manager"
  ssh "pkgin -y install xfce4 xfce4-goodies xorg-server xdm 2>&1 | tail -20"
  timeout 1800


step "enable xdm, which is the graphical login"
  ssh "printf 'xdm=YES\n' >> /etc/rc.conf; grep -c xdm=YES /etc/rc.conf"
  timeout 60


# THE SESSION IS STARTED FROM THE CONSOLE, because xdm was already enabled by the installer and this
# guest is at a root prompt, not a display manager. Starting it here makes the greeter draw on the
# screen this stage records, which is the claim the desktop packages are for.
step "start the display manager from the console"
  input text "sh /etc/rc.d/xdm start 2>&1 | tail -3"
  settle 3


step "run it"
  input ret
  settle 30


# THE GREETER IS THE PROOF THE DESKTOP RUNS. xdm draws a login panel; a machine with no X server, a
# missing xfce or a broken config draws nothing and leaves the text console. So the gate is "the text
# console is gone", which is a shape the screen cannot fake.
step "the display manager replaced the text console"
  repeat
    do
      item
        settle 10
      item "read the screen"
        read
          name desk
    until
      bind up
      source desk
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      scale 1
      without [[login], [root@]]
    max 40


step "flush the writes before the machine stops"
  ssh "sync"
  timeout 300


step "shut the machine down"
  stop ssh
  timeout 300


step "wait for the machine to stop"
  wait_until stopped
  timeout 600


step "publish the disk"
  save "{{ out }}"
