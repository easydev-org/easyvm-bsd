# DOES THE PUBLISHED DISK START? Boot it, look, and kill it - nothing else.
#
# "THE INSTALL LEG PASSED" IS NOT THE SAME CLAIM, and GhostBSD is the reason the distinction was
# written down here. The install walk ends on GBI's "Installation Completed" dialog; what it has
# proven by then is that files were copied, not that the disk boots. This file boots the published
# disk with NO MEDIUM ATTACHED and asks the one question the other one cannot: does the firmware
# hand control to it, and does a GhostBSD desktop follow?
#
# IT PUBLISHES NO DISK. `out:` is empty in the stage that runs this, so the only artifact is the
# recording - which is what a person watches after a failure.
#
# THE MEMORY IS 8 GiB FOR THE SAME REASON THE INSTALL NEEDS IT: a live medium is not attached here,
# but the disk's own loader is loaded from a ZFS pool whose cache wants the room, and 4 GiB is the
# number that already failed on this product once.
walkthrough "the published disk starts - nothing else"
resolution 1920x1080
recording_resolution 1920x1080

step "boot the published disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "8192"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "virtio-vga,xres=1920,yres=1080"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 600

# `BdsDxe: starting` IS THE FIRMWARE SAYING IT FOUND SOMETHING BOOTABLE, and a disk it cannot start
# prints the opposite sentence on the same console.
step "the firmware handed control to the disk"
  until "BdsDxe: starting"
  from console
  timeout 300

# THE STEP THAT MAKES THIS A GHOSTBSD CLAIM RATHER THAN A FIRMWARE ONE: the product's own first-boot
# wizard, or the desktop behind it, has to appear. A disk whose ESP holds a zero-byte boot loader -
# which is the defect this repository's FreeBSD file records against GBI - would pass the console
# check above and never draw either of these.
step "a ghostbsd screen, which is what says the disk is not just bootable but usable"
  repeat
    do
      item
        settle 15
      item "read the screen"
        read
          name screen
    until
      bind alive
      source screen
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [[ghostbsd, initial, setup], [please, select, your, language], [welcome, to, ghostbsd]]
    max 60

step "record three minutes of the boot"
  settle 180

step "stop the machine"
  stop kill
  timeout 120
