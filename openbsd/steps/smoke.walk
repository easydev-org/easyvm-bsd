# DOES THE PUBLISHED DISK START? Boot it, look, and kill it - nothing else.
#
# "THE INSTALL LEG PASSED" IS NOT THE SAME CLAIM, and OpenBSD is why this file exists as its own leg.
# The install walk ends on the installer's own "CONGRATULATIONS!" line, which says the sets were
# unpacked; it does not say the firmware can start the disk or that xenodm comes up. Both were
# MEASURED in a real guest before this file was written.
#
# IT PUBLISHES NO DISK: `out:` is empty in the stage that runs this. The artifact is the recording.
#
# THE SCREEN CHECK DOES NOT NAME `login`, AND THAT COST A 21-MINUTE CI RUN TO LEARN.
#
# MEASURED on run 45664215546, which sat on this step for its whole budget: the xenodm panel's own
# `Login:` label OCRs as `togin:` - a lowercase t - so a gate naming `login` is a gate that can never
# close, however long it waits.
#
# AND THE PANEL IS NOT FIXED-SIZE, which is the other half of the same lesson: the frame the engine
# captures is whatever the firmware handed the guest, and OpenBSD's efifb takes the mode the VGA
# device offers. A rectangle written against one size crops empty space at another. So this gate reads
# the WHOLE frame with no rectangle and asks the one question that holds at every size: the console's
# own text is not on the screen any more.
#
# THE CONSOLE LINE IS THE PART THAT IS INDEPENDENT OF OCR. `BdsDxe: starting` is the firmware saying
# it found something bootable; a disk it cannot start prints the opposite sentence on the same stream.
walkthrough "the published disk starts - nothing else"
resolution 1920x1080
recording_resolution 1920x1080

step "boot the published disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "virtio-vga,xres=1920,yres=1080"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 600

step "the firmware handed control to the disk"
  until "BdsDxe: starting"
  from console
  timeout 300

# THE GRAPHICAL HALF, AND IT IS MEASURED IN PIXELS RATHER THAN WORDS BECAUSE THE WORDS FAILED.
#
# MEASURED on run 45664215546: the gate named `login` and the panel's own `Login:` label OCRs as
# `togin:`. That run spent its whole 21-minute budget on this one step.
#
# So the question is the shape of the frame, which holds at every size and in every language:
#
#	mean_between  [8, 255]      - not a black screen
#	spread_between [1, 128]     - not one flat colour
#
# THE UNITS ARE 0-255, WHICH TWO RUNS SETTLED. Run 45670880360 said
#
#	mean brightness 0.1557, wanted 1.0000..255.0000
#
# and a run whose range was written as fractions said `mean brightness 1.3160, wanted
# 0.0200..1.0000`. `screen.Mean` is documented "0..255 over the rect", so 0-255 is the scale.
#
# AND THE READING THAT MATTERS IS THE SECOND ONE: 1.316 IS A BLACK SCREEN. `BdsDxe: starting` arrived
# in TWO SECONDS - the log says so - and this step captured a frame immediately after it, when the
# kernel had printed nothing to the display yet. The wait below is what gives the kernel time to take
# the screen over.
#
# xenodm's panel is a dark blue field with a yellow pufferfish and white labels; a kernel that panicked
# leaves a console's worth of high-contrast text; a disk the firmware could not start is black. The
# three are told apart by these two numbers alone, and neither is tuned to a threshold that only one
# guest can satisfy - the same pair is what sd-microvm's desktop walks use for the same question.
# THE KERNEL NEEDS TIME TO TAKE THE SCREEN, AND THIS IS THE SETTLE THAT GIVES IT TO THEM.
#
# MEASURED on run 45673260547: `BdsDxe: starting` in 2s, the frame captured right after it, mean
# brightness 1.316 - a black screen, because the firmware's own text had just been cleared and the
# kernel had not drawn yet. OpenBSD's probe takes tens of seconds before xenodm paints.
step "let the kernel take the screen over"
  settle 75

step "the screen is not black, so the machine got a display"
  read
    name boot_screen

step "there is something drawn on it"
  check
    must true
    source boot_screen
    mode mean_between
    name not_black
    range [8, 255]
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]

step "and it is not one flat colour"
  check
    must true
    source boot_screen
    mode spread_between
    name has_content
    range [1, 128]
    rect [0, 0, 1920, 1080]
    rect_at [1920, 1080]

step "record three minutes of the boot"
  settle 180

step "stop the machine"
  stop kill
  timeout 120
