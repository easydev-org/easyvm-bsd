# midnightbsd 4.0.9 - the installed system, over ssh, with the desktop this release is built around.
#
# THE INSTALL WALK PROVES THE INSTALLER ANSWERED EVERY QUESTION. This one proves the machine that
# came out of it can reach a package mirror and install the desktop MidnightBSD has been built around
# since 2021 - Xfce - and that a session actually comes up on screen.
#
# WHY THE DESKTOP IS HERE AND NOT IN THE INSTALL, WHICH IS WHERE freebsd PUTS IT.
#
# MEASURED, reading the disc this repository installs from (`MidnightBSD-4.0.9--amd64-disc1.iso`,
# 1031 MiB). `usr/midnightbsd-dist/` holds seven sets:
#
#	base.txz  177,887,812   kernel.txz 56,347,824   kernel-dbg.txz 103,999,492
#	lib32.txz  77,197,736   mports.txz 28,520,548   src.txz       207,797,884
#	tests.txz  19,541,932
#
# and NO desktop set at all. `base.txz` unpacks to 28,172 entries of which ZERO are under
# `usr/X11R6`, and `xorg`/`xfce`/`lumina` appear in that list zero times. So the 677 MiB image the
# install leg publishes is a complete base system with an empty `/usr/local` - not a desktop with
# something missing.
#
# THAT IS MIDNIGHTBSD'S OWN DESIGN, and the mechanism is a file, not a manual step. `etc/rc.d/firstboot`
# from `base.txz`, read out here:
#
#	receipt="/etc/fbreceipt"
#	if [ ! -f ${receipt} ]; then
#	        echo -e "...MidnightBSD FirstBoot Configuration"
#	        echo "This utility requires an active Internet connection."
#	        ...  "Do you wish to enable a graphical environment? (yes or no)"
#	        ...  /usr/sbin/mport install midnightbsd-desktop
#	        ...  /usr/sbin/sysrc mlogind_enable=YES
#	        ...  /usr/sbin/sysrc dbus_enable=YES
#	        ...  set_default_session ${session}
#	        touch ${receipt}
#	fi
#
# So the disc ships a script that will install the desktop on FIRST BOOT, from the project's mirror.
# MEASURED on the published disk: it runs and holds the console at
#
#	MidnightBSD FirstBoot Configuration
#	Set your preferred package mirror? (us.uk, jp)
#
# which is why an ssh leg that just waits for sshd times out - the wizard owns the console, and every
# answer it wants is one this walk cannot read with OCR (the model returns `dpstalb)` for its panes).
#
# SO THIS STAGE DOES WHAT THAT SCRIPT DOES, ON PURPOSE AND IN THE OPEN, and then writes the receipt so
# the wizard never runs again. The package list is copied from the script rather than invented:
# `midnightbsd-desktop` is the meta-package that provides Xorg, mlogind and Xfce in one install.
walkthrough "midnightbsd 4.0.9 - sshd, Xfce, and a desktop"
resolution 1920x1080
recording_resolution 1920x1080
user vmuser
var out
  default out/midnightbsd-ssh.qcow2
  from args.out
# THE ACCOUNT IS A VAR AND NOT ONLY THE `user:` SHORTHAND, because the commands below interpolate it
# into a password grep and a sudoers path. MEASURED: with only `user vmuser` the parse fails with
# `"{{ user }}" names "user", which is not in vars`.
var user
  default vmuser
  from args.user
password admin1
ssh_port 2222

step "boot the disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 900

# THE WIZARD IS ALREADY OFF, AND THIS STAGE USED TO PRESS KEYS AT A WIZARD THAT NEVER APPEARED.
#
# `midnightbsd/steps/install.walk` WRITES `/etc/fbreceipt` IN THE CHROOT, and that file is the
# firstboot script's own off switch - its header quotes the script:
#
#	receipt="/etc/fbreceipt"
#	if [ ! -f ${receipt} ]; then ... install the desktop ... ; touch ${receipt}; fi
#
# SO THE DISK THIS STAGE BOOTS HAS ALREADY HAD FIRSTBOOT, and does not run one again. `sshd` was also
# already ticked on the installer's Services pane - `install.walk` says so in its own measurement
# ("Services   sshd ticked, mouse, ntpd, mdns  -> RET") - so nothing here has to enable it.
#
# AND KEYS AT A WIZARD THAT IS NOT THERE LAND SOMEWHERE ELSE. MEASURED, run 45934963111:
#
#	=== answer the firstboot wizard and stop it installing anything
#	  waiting 50s, as measured
#	=== wait for sshd
#	  error: the repeat ran 60 attempt(s) and the condition never held: sshd does not accept a connection
#
# with the host's own diagnosis quoting the NIC state as `172.30.0.2 dev qemubr0 FAILED` - the guest
# never answered on the network at all. THE FIVE BLIND `ret`/`no` PAIRS WENT TO THE CONSOLE LOGIN
# PROMPT, where `ret` submits an empty username and `no` becomes one, repeatedly.
#
# SO THIS STAGE WAITS FOR THE SYSTEM RATHER THAN TYPING AT IT. The console is read for a login prompt,
# which is what a booted MidnightBSD shows when nothing owns the console, and nothing is sent.
step "the console shows the system is up, with no wizard to answer"
  repeat
    do
      item
        settle 10
      item "read the console"
        read
          name boot
    until
      bind up
      source boot
      mode text
      rect [0, 0, 1024, 768]
      rect_at [1024, 768]
      scale 1
      words [[login:], [password:]]
    max 60


step "wait for sshd"
  repeat
    until machine_ssh
    max 60
    pause 10

step "prove the kernel over ssh"
  ssh "uname -a"

step "prove the account over ssh"
  ssh "id -un"

# THE MACHINE THE INSTALLER WROTE HAS NO NETWORK CONFIGURATION OF ITS OWN, which is the same thing
# freebsd's leg had to solve: bsdinstall's network menu configures the INSTALLER's runtime. The
# interface is brought up here, and DHCP is what the tap behind this guest serves.
step "report the interfaces the booted system has"
  ssh "ifconfig -a | head -30"
  timeout 120

step "bring the interface up, because the install walk configured none"
  ssh "sudo sh -c 'ifconfig vtnet0 up 2>/dev/null || true; dhclient vtnet0 >/dev/null 2>&1 || true; ifconfig vtnet0'"
  timeout 240

step "prove the address"
  ssh "ifconfig vtnet0 | grep 'inet '"
  timeout 120

# A BOOTED SYSTEM HAS NO RESOLVER; the one written into the chroot during the install does not
# survive into this boot.
step "give the booted system a resolver"
  ssh "sudo sh -c 'printf \"%s\n\" \"nameserver 172.30.0.1\" \"nameserver 1.1.1.1\" > /etc/resolv.conf'; cat /etc/resolv.conf"
  timeout 120

step "point the package manager at the mirror the wizard would have chosen"
  ssh "sudo mport config set mirror_region us 2>&1; sudo mport config get mirror_region 2>&1"
  timeout 180

step "index the mirror, which is the only thing that makes an install possible"
  ssh "sudo mport index 2>&1 | tail -5"
  timeout 1800

# `midnightbsd-desktop` AND NOT `xorg xfce4` SEPARATELY: the wizard's own script installs this one
# name, and its comment says what it is - "midnightbsd-desktop provides Xorg, mlogind and xfce". It is
# the release's own definition of a desktop, so this stage installs that rather than a list assembled
# here.
step "install midnightbsd-desktop, the release's own meta-package for Xorg, mlogind and Xfce"
  ssh "sudo env ASSUME_ALWAYS_YES=yes mport install -A -M midnightbsd-desktop 2>&1 | tail -40"
  timeout 7200

step "prove the desktop's files are on disk, not just its package record"
  ssh "ls -l /usr/local/bin/Xorg /usr/local/bin/startxfce4 /usr/local/bin/xfce4-session /usr/local/sbin/mlogind 2>&1"
  timeout 180

step "prove xfce's session file exists, which is what a login manager lists"
  ssh "ls -l /usr/local/share/xsessions/ 2>&1"
  timeout 120

# THE SESSION FILE FOR THE ACCOUNT. MidnightBSD 2.1 and later ship a default `.xinitrc` that starts
# Xfce when it is installed, but writing it explicitly is what a reader can check.
step "give the account a session that starts xfce"
  ssh "printf '%s\n' '#!/bin/sh' 'exec /usr/local/bin/startxfce4' > ~/.xsession && chmod +x ~/.xsession && cat ~/.xsession"
  timeout 120

step "write the same session for the console, which is what startx reads"
  ssh "printf '%s\n' 'exec /usr/local/bin/startxfce4' > ~/.xinitrc && cat ~/.xinitrc"
  timeout 120

# THE TWO SERVICES THE WIZARD ENABLES, ENABLED HERE FOR THE SAME REASON: mlogind is the login manager
# this release ships since 2.1, and dbus is what an Xfce session needs to start at all.
step "enable the login manager and dbus at boot"
  ssh "sudo sh -c 'sysrc mlogind_enable=YES dbus_enable=YES; sysrc -a | grep -E \"mlogind|dbus\"'"
  timeout 180

step "let the account escalate without a password, which is what the session needs"
  ssh "sudo sh -c 'printf \"%s\n\" \"{{ user }} ALL=(ALL) NOPASSWD:ALL\" > /usr/local/etc/sudoers.d/90-{{ user }}\"; sudo chmod 0440 /usr/local/etc/sudoers.d/90-{{ user }}; sudo cat /usr/local/etc/sudoers.d/90-{{ user }}'"
  timeout 180

step "prove the account's password is a hash and not a locked field"
  ssh "sh -c 'grep \"^{{ user }}:\" /etc/master.passwd | cut -d: -f2 | cut -c1-3'"
  timeout 120

# THE RECEIPT. Writing it is what the wizard does at its own end (`touch ${receipt}`), and it is what
# stops the wizard from ever running again on this disk.
step "write firstboot's receipt, so the wizard never runs on this disk again"
  ssh "sudo touch /etc/fbreceipt; ls -l /etc/fbreceipt"
  timeout 120

step "flush the writes before the session starts"
  ssh "sudo sync"
  timeout 300

step "start the session, because a login manager only draws after it has been started once"
  ssh "sudo service mlogind restart 2>&1 | tail -5; sleep 20; pgrep -x mlogind && echo MLOGIND_UP"
  timeout 600

# THE PICTURE IS THE CLAIM. A machine that installed Xfce and then cannot draw it is not a desktop,
# and a package's exit status cannot tell the two apart.
step "the xfce session is drawing on screen"
  repeat
    do
      item
        settle 15
      item "read the screen"
        read
          name desk
    until
      bind ready
      source desk
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      without [[login], [password], [midnightbsd]]
      words [[xfce], [application], [desktop], [settings], [session]]
    max 60

step "flush the writes before the machine stops"
  ssh "sudo sync"
  timeout 300

step "press the power button"
  acpi power
  timeout 60

step "wait for the machine to stop"
  wait_until stopped
  timeout 600

step "publish the disk"
  save "{{ out }}"
