# netbsd 11.1 - sysinst under UEFI, answered blind, to a published disk.
#
# THE INSTALLER IS BOOTED BY OVMF AND NOT BY BIOS, AND THAT IS THE FIX FOR A REAL FAILURE.
#
# MEASURED, the disk the BIOS path published did not start on the firmware CI uses:
#
#	BdsDxe: failed to load Boot0002 "UEFI Misc Device" from PciRoot(0x0)/Pci(0x5,0x0): Not Found
#	BdsDxe: No bootable option or device was found.
#
# The BIOS path writes an MBR and BIOS bootblocks, and UEFI reads neither: it looks only for
# \EFI\BOOT\BOOTX64.EFI inside an EFI System Partition. `netbsd.iso` carries its own UEFI loader
# (EFI/NetBSD/boot.cfg), so booting the installer under OVMF is all that is needed - and MEASURED,
# sysinst's UEFI path then writes the ESP itself.
#
# THE PAGE SEQUENCE IS DIFFERENT UNDER UEFI AND THIS FILE WAS MEASURED ON IT, NOT ASSUMED:
#
#	NetBSD/amd64 11.1 ... installation messages menu       -> RET (English is first, selected)
#	Keyboard type                                          -> b, RET (US-English)
#	NetBSD-11.1 Install System                             -> RET (a: Install NetBSD to hard disk)
#	Shall we continue?  a: No   b: Yes                     -> b, RET  <-- DEFAULT IS NO
#	On which disk  a: ld0                                  -> RET
#	partitioning scheme  a: GPT                            -> RET
#	geometry  a: correct geometry                          -> RET
#	sizes  b: Use default partition sizes                  -> b, RET
#	partitions summary  x: Partition sizes ok              -> x, RET
#	Shall we continue?                                     -> b, RET  <-- DEFAULT IS NO AGAIN
#	distribution sets  a: Full installation                -> RET
#
# THERE IS NO BOOTBLOCKS PAGE ON THIS PATH. MEASURED: after the second `Shall we continue?` the
# installer went STRAIGHT to the distribution sets - the BIOS path's "would you like to install the
# normal set of bootblocks" page does not exist under UEFI, because the ESP is what the firmware
# starts and sysinst writes it without asking.
#
# TWO ANSWERS DEFAULT TO `No` AND BOTH ARE NEEDED: `Shall we continue?` (pressing return there returns
# to the main menu with nothing written) and `Enable sshd` / `Enable xdm`.
#
# THE SCREEN IS NOT READ, AND THE REASON IS MEASURED. sysinst draws at 720x400 with a small
# low-contrast font, and tesseract returns noise for it:
#
#	none of "zzzznotpresent" in "j- oie alll i estes Meal AA eee Lelalaentaitor AA ..."
#
# So the steps carry `settle:` and the sequence above was measured key by key. The one gate this file
# keeps is on the console's own text, which is not OCR.
#
# THE NETWORK IS NOT CONFIGURED HERE. `Configure network` TERMINATES sysinst at its netmask prompt on
# this medium - MEASURED, "sysinst terminated. To return to the installer, quit this shell ...". That
# happens AFTER the sets are extracted, so the disk is complete. Xfce and the interface come up in
# `ssh.walk`, because a package install is a network operation and this stage has none.
walkthrough "netbsd 11.1 - sysinst under uefi, to an installed disk"
resolution 1920x1080
recording_resolution 1920x1080
var out
  default out/distro.qcow2
  from args.out
password admin1
var shutdown
  default kill
  from args.shutdown
var user
  default vmuser
  from args.user

step "the media this stage boots from is already on disk"
  needs [netbsd.iso]

step "create the empty disk"
  disk
    file disk.qcow2
    size 128

step "boot the installer under uefi"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-cpu", "Skylake-Client-v4"], ["-smp", "4"], ["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "2048"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "VGA,xres=1920,yres=1080,vgamem_mb=32"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=netbsd.iso,media=cdrom,readonly=on,if=none,id=media0"], ["-device", "ide-cd,drive=media0,bootindex=0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=1"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 1200

step "wait for the installer to draw"
  settle 80

step "english, which is the first entry"
  input ret
  settle 10

step "us keyboard"
  do
    item
      input text "b"
    item
      input ret
      settle 10

step "install netbsd to hard disk, which is the first entry"
  input ret
  settle 14

# THE DEFAULT HERE IS `No`.
step "continue - yes"
  do
    item
      input text "b"
    item
      input ret
      settle 16

step "the only disk"
  input ret
  settle 16

step "the gpt scheme, which is what uefi needs"
  input ret
  settle 16

step "the geometry the bios reported"
  input ret
  settle 16

step "the default partition sizes"
  do
    item
      input text "b"
    item
      input ret
      settle 18

step "accept the partition table"
  do
    item
      input text "x"
    item
      input ret
      settle 20

# `No` AGAIN BY DEFAULT.
step "continue - yes, the last chance to quit"
  do
    item
      input text "b"
    item
      input ret
      settle 22

# NO BOOTBLOCKS PAGE ON THIS PATH - see the header. The distribution menu follows immediately, and
# its first entry is `a: Full installation`.
step "the full distribution"
  input ret
  settle 20

step "install from the cd-rom, which is where the sets are"
  input ret
  settle 22

step "the note about the optional sets this medium does not carry"
  input ret
  settle 30

# THE EXTRACTION IS THE LONG WAIT AND IT IS THE ONE THING A FIXED DELAY CANNOT COVER. MEASURED on this
# medium: about four minutes to unpack the 19 selected sets. `settle 400` is the ceiling; the next
# keypress is harmless if it arrives after the page appears, because the page after it is the password
# prompt and a stray return there simply re-asks.
step "wait for the sets to be extracted"
  settle 400

step "the extraction is complete"
  input ret
  settle 14

step "the root password - first entry"
  do
    item
      input text "{{ password }}"
    item
      settle 5
    item
      input ret
      settle 5

step "the root password - the repeat"
  do
    item
      input text "{{ password }}"
    item
      settle 5
    item
      input ret
      settle 14

# THE CONFIGURATION MENU. `g` enables sshd and `k` enables xdm; both default to NO and both are what
# the later stages need. Each returns to the same menu, so the two keys are sent separately with the
# redraw between them.
step "enable sshd"
  do
    item
      input text "g"
    item
      input ret
      settle 14

step "enable xdm, the graphical login"
  do
    item
      input text "k"
    item
      input ret
      settle 14

step "the timezone menu"
  do
    item
      input text "b"
    item
      input ret
      settle 14

step "utc, the first entry"
  input ret
  settle 16

# `Configure network` IS NOT TOUCHED: MEASURED, it terminates sysinst at its netmask prompt. See the
# header. Everything the disk needs is already written at this point.
step "finish configuring"
  do
    item
      input text "x"
    item
      input ret
      settle 20

# THE INSTALLER'S LAST ACT IS TO ASK WHETHER TO REBOOT OR DROP TO A SHELL. The disk is complete and
# the machine is about to be killed anyway, so a plain return is harmless here.
step "the installer's ending"
  do
    item
      input ret
      settle 20

step "stop the machine"
  stop "{{ shutdown }}"
  timeout 300

step "publish the disk"
    save "{{ out }}"
